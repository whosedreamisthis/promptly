NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

GEMINI_API_KEY=
# Set to false to return mock replies and skip model calls (saves tokens)
USE_AI_MODEL=true

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Database seed: host of the development database (db:seed refuses any other host)
SEED_ALLOWED_HOST=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Total model calls per day across all users before replies switch to the mock reply (default 500)
GLOBAL_DAILY_MODEL_LIMIT=500

# Model replies per person per day before sample replies are shown (default 10; set to 1 to test the limit)
# CHAT_DAILY_LIMIT=10

# Demo mode: secret that protects /api/demo/cleanup (Vercel Cron sends it as a bearer token)
CRON_SECRET=
# Demos per address per day (default 3), demos per day overall (default 30) and hours before a demo user is deleted (default 12)
# DEMO_LIMIT_PER_IP=3
# DEMO_LIMIT_GLOBAL=30
# DEMO_USER_TTL_HOURS=12
